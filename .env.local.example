# MinimalCAD Web -- Supabase configuration
#
# Copy this file to .env.local (already gitignored via the *.local rule)
# and fill in your project's own values from the Supabase dashboard:
# Project Settings -> API.
#
# Both values below are BROWSER-SAFE by design (protected by Row Level
# Security, see supabase/migrations/0001_drawings.sql) -- never put a
# service-role/secret key in this file or anywhere under src/.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Prefer the current "Publishable key" (starts with sb_publishable_) shown
# on the API settings page. If your project only shows the legacy "anon"
# key instead, use VITE_SUPABASE_ANON_KEY below with that value -- either
# works identically with this app's Supabase client.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_SUPABASE_ANON_KEY=eyJ...
